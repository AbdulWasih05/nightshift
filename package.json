{
  "name": "nightshift",
  "private": true,
  "version": "0.1.0",
  "description": "The maintainer's night shift: a local agent that triages PRs and issues overnight and never acts without approval.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "db:up": "docker compose up -d db",
    "db:migrate": "tsx scripts/migrate.ts",
    "nightshift": "tsx apps/cli/src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "nights:update": "tsx scripts/nights-update.ts",
    "stack": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/night-stack.ps1",
    "night": "pnpm -s stack && pnpm -s nightshift schedule --once-in 2",
    "stack:down": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stack-down.ps1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "dotenv": "^18.0.8",
    "pg": "^8.23.1"
  }
}
