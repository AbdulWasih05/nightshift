# Laptop mode only. The hosted dashboard never reads GITHUB_TOKEN from env;
# it gets the token through Auth0 Token Vault.

# Postgres: Tiger Data service URL, or the local docker-compose stand-in.
DATABASE_URL=postgres://nightshift:nightshift@localhost:5433/nightshift

# GitHub token used by the collector (read) and `nightshift post` (write, own repo only). Required.
# Use a FINE-GRAINED PAT scoped to "Only select repositories: AbdulWasih05/nightshift" with
# Issues + Pull requests read/write. Public partner repos stay readable with it, but the token itself
# cannot write to them: server-side enforcement behind the client-side allowlist.
# Do not use a classic PAT or `gh auth token` here: those can write to any repo you can comment on.
GITHUB_TOKEN=

# Ollama
OLLAMA_HOST=http://localhost:11434
TRIAGE_MODEL=gemma3:4b
TRIAGE_FALLBACK_MODEL=gemma3:1b
# Optional: the Ollama tag actually called, e.g. a Modelfile copy of the same weights with a thread cap
# (see scripts/ollama-modelfiles/). model_path still records TRIAGE_MODEL.
TRIAGE_MODEL_TAG=
TRIAGE_FALLBACK_MODEL_TAG=
EMBED_MODEL=nomic-embed-text

# Render-hosted model (last fallback, and the model for the hosted demo). OpenAI-compatible endpoint.
HOSTED_MODEL_URL=
HOSTED_MODEL_NAME=
HOSTED_MODEL_API_KEY=

# Temporal (local dev server by default)
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=nightshift

# Sentry agent monitoring
SENTRY_DSN=

# TabPFN sidecar
TABPFN_URL=http://localhost:8000

# Auth0 (dashboard)
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
APP_BASE_URL=

# ElevenLabs (should-ship)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
